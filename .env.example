# Backend API URL
# Local development example:
REACT_APP_API_URL=http://localhost:3000/api/v1
# Production example:
# REACT_APP_API_URL=https://api.familyacademy.et/api/v1

# Debug mode (true/false). CRA sets NODE_ENV automatically.
REACT_APP_DEBUG=true

# Disable source maps in production builds unless you explicitly need them.
GENERATE_SOURCEMAP=false

# Application name
REACT_APP_NAME=Family Academy Admin

# Version
REACT_APP_VERSION=2.0.0

# Landing page downloads
# Set these to your hosted binaries or leave them to use the default /downloads paths.
# REACT_APP_DOWNLOAD_BASE_URL=https://downloads.familyacademy.et
# REACT_APP_CLIENT_WINDOWS_INSTALLER_URL=https://...
# REACT_APP_CLIENT_WINDOWS_ZIP_URL=https://...
# REACT_APP_CLIENT_MACOS_URL=https://...
# REACT_APP_CLIENT_LINUX_URL=https://...
# REACT_APP_CLIENT_ANDROID_ZIP_URL=https://...
# REACT_APP_CLIENT_ANDROID_AAB_URL=https://...
# REACT_APP_TV_ANDROID_URL=https://...
# REACT_APP_TV_ANDROID_AAB_URL=https://...
# REACT_APP_TV_LINUX_URL=https://...
# REACT_APP_TV_MACOS_URL=https://...
