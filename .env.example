# Backend API URL
# Local development example:
REACT_APP_API_URL=http://localhost:3000/api/v1
# Production example:
# REACT_APP_API_URL=https://your-backend-url.com/api/v1

# Debug mode (true/false). CRA sets NODE_ENV automatically.
REACT_APP_DEBUG=true

# Disable source maps in production builds unless you explicitly need them.
GENERATE_SOURCEMAP=false

# Application name
REACT_APP_NAME=Family Academy Admin

# Version
REACT_APP_VERSION=2.0.0
